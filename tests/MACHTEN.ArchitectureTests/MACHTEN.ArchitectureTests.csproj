<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- TUnit runs on Microsoft.Testing.Platform: the test project builds as its
         own executable instead of being hosted by VSTest. -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="TUnit" Version="1.65.68" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MACHTEN.Domain\MACHTEN.Domain.csproj" />
    <ProjectReference Include="..\..\src\MACHTEN.Application\MACHTEN.Application.csproj" />
    <ProjectReference Include="..\..\src\MACHTEN.Infrastructure\MACHTEN.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MACHTEN.Api\MACHTEN.Api.csproj" />
  </ItemGroup>

</Project>